  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 Your child will play a web-based video game for as long as they
    wish.\n\u2022 In the game, your child pilots a spaceship that shoots targets
    linked to clusters of musical tones.\n\u2022 They may stop playing or take breaks
    at any time.\n\u2022 After gameplay, your child will complete a brief (~10 minute)
    tone-identification task.\n\u2022 Your child will also complete a short questionnaire
    about age, gender, and musical background.\n\u2022 No identifying audio or video
    will be recorded."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
